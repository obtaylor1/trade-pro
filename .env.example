DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-different-32-character-secret
PORT=5001

# First broker: keep blank until Alpaca approves the application.
ALPACA_CLIENT_ID=
ALPACA_CLIENT_SECRET=
ALPACA_REDIRECT_URI=http://localhost:5001/api/brokers/alpaca/oauth/callback

# Optional production providers; application works without them.
ERROR_MONITORING_DSN=
EMAIL_PROVIDER_API_KEY=
